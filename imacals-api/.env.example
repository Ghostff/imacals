# Database Configuration
DB_HOST=imacals-db
DB_PORT=5432
# Host-side port for psql/GUI clients — kept off 5432 so a locally installed postgres (or a
# sibling project's db container) doesn't clash.
DB_HOST_PORT=5437
DB_NAME=imacals
DB_USERNAME=user
DB_PASSWORD=password
DB_INIT_ARGS="--encoding=UTF-8 --locale=C"

DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Server Configuration
APP_PORT=3032
APP_URL="http://localhost"

# Logging Configuration
RUST_LOG=info
LOG_FORMAT=pretty

# Security
APP_SECRET="eyJhbGciOiJIUzI1NiJ9.eyJSb2xlIjoiQWRtaW4iLCJJc3N1ZXIiOiJJc3N1ZXIiLCJVc2VybmFtZSI6IkphdmFJblVzZSIsImV4cCI6MTY5NDM2NTQyNywiaWF0IjoxNjk0MzY1NDI3fQ.MnWUmGc9B-2c9uTUk-gVuJfS5YdXDE0Qv_G6tIksMXw"

# Performance
CPU_COUNT=2

# Storage — MinIO (dev/staging) or AWS S3 (prod)
# Dev:     S3_ENDPOINT=http://imacals-minio:9000  (Docker internal hostname)
# Staging: S3_ENDPOINT=http://<your-minio-host>:9000
# Prod:    S3_ENDPOINT=                           (empty → real AWS S3)
S3_ENDPOINT=http://imacals-minio:9000
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9003
S3_BUCKET=imacals-bucket
S3_ACCESS_KEY=user
S3_SECRET_KEY=password
S3_REGION=us-east-1

# Mail — transactional + campaign delivery. Dev points at the Mailpit catcher (imacals-mail), which swallows
# every send and shows it at http://localhost:8025 instead of hitting real inboxes.
# Staging/prod: point MAIL_HOST/MAIL_PORT at the real SMTP relay and set credentials.
MAIL_HOST=imacals-mail
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@imacals.local
MAIL_FROM_NAME=Imacals
# Host-side ports for the Mailpit inbox / SMTP listener (in-network it stays 1025).
MAIL_UI_PORT=8026
MAIL_SMTP_PORT=1026

# Dev
USER_UID=1000
DASHBOARD_HOST_PORT=5174
# Customer storefront (imacals.com). Off 5173/5174 so it can run beside the dashboard.
WEB_HOST_PORT=5175